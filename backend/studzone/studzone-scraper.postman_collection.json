  "item": [
    {
      "name": "1 - GET Login Page",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const html = pm.response.text();\n// Explicitly targets the clean value string\nconst match = html.match(/name=\"__RequestVerificationToken\"[^>]*value=\"([^\"]+)\"/);\n\nif (match && match[1]) {\n    // match[1] isolates the exact alphanumeric string inside the quotes\n    pm.collectionVariables.set('csrf', match[1]);\n    console.log('Clean Token Successfully Synced:', match[1]);\n} else {\n    console.warn('Could not find token attribute structure.');\n}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "body": {
          "mode": "urlencoded",
          "urlencoded": []
        },
        "url": {
          "raw": "https://ecampus.psgtech.ac.in/studzone",
          "protocol": "https",
          "host": [
            "ecampus",
            "psgtech",
            "ac",
            "in"
          ],
          "path": [
            "studzone"
          ]
        }
      },
      "response": []
    },
